# Copy to .env.local for local development. In production these are set in
# Vercel (Project → Settings → Environment Variables). Never commit real keys.

# Supabase (database)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: Supabase dashboard → Project Settings → API Keys. Server only.
SUPABASE_SECRET_KEY=

# Stripe (payments)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# From the webhook endpoint you add in Stripe for /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Google Places API (New) key for address autocomplete. Optional: without it
# the form asks for street, community and postal code instead.
GOOGLE_MAPS_API_KEY=

# Sign-in for /admin (pickup list and CSV export)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Optional: pickup radius from downtown London, in km (default 21)
SERVICE_RADIUS_KM=
